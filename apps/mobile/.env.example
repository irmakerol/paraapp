# Build-time settings for the phone app (inlined into the bundle; none of these are secrets).
# The TestFlight workflow fills them from the hosted Supabase/Vercel projects.
EXPO_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
EXPO_PUBLIC_SUPABASE_ANON_KEY=replace-with-anon-or-publishable-key
# The website (used for uploads, legal pages and the logbook).
EXPO_PUBLIC_WEB_URL=http://localhost:3000
EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID=
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=
# Set by CI to the GitHub run number.
IOS_BUILD_NUMBER=1
