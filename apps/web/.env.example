# Copy to .env.local and fill in. Never commit .env.local.
# Values for local development come from `pnpm db:start` (it prints the API URL and keys).

NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=replace-with-anon-or-publishable-key
# Server only. Used for the guardian-consent flow. Never expose to the browser.
SUPABASE_SERVICE_ROLE_KEY=replace-with-service-role-or-secret-key

# Show the "Continue with Google" button (also enable [auth.external.google] in supabase/config.toml).
NEXT_PUBLIC_AUTH_GOOGLE_ENABLED=false

# 32 random bytes, base64. Generate with: openssl rand -base64 32
LICENCE_ENCRYPTION_KEY=replace-me

# Outgoing mail for guardian consent. Local dev: Supabase's mail catcher (view at http://127.0.0.1:54324).
SMTP_HOST=127.0.0.1
SMTP_PORT=54325
SMTP_USER=
SMTP_PASS=
SMTP_FROM="ParaApp <no-reply@flyanatolia.com>"
