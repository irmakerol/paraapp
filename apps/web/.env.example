# Copy to .env.local and fill in. Never commit .env.local.
# Values for local development come from `pnpm db:start` (it prints the API URL and keys).

NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=replace-with-anon-or-publishable-key
# Server only. Used for the guardian-consent flow. Never expose to the browser.
SUPABASE_SERVICE_ROLE_KEY=replace-with-service-role-or-secret-key

# Show the "Continue with Google" button (also enable [auth.external.google] in supabase/config.toml).
NEXT_PUBLIC_AUTH_GOOGLE_ENABLED=false

# 32 random bytes, base64. Generate with: openssl rand -base64 32
LICENCE_ENCRYPTION_KEY=replace-me
# A different 32-byte key for injury details in incident reports (health data).
INCIDENT_ENCRYPTION_KEY=replace-me

# Outgoing mail for guardian consent. Local dev: Supabase's mail catcher (view at http://127.0.0.1:54324).
SMTP_HOST=127.0.0.1
SMTP_PORT=54325
SMTP_USER=
SMTP_PASS=
SMTP_FROM="ParaApp <no-reply@flyanatolia.com>"

# Web push (optional). Generate a key pair with: npx web-push generate-vapid-keys
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:info@flyanatolia.com

# Protects /api/cron/* (scheduled news push). Any long random string: openssl rand -hex 32
CRON_SECRET=

# Weather forecasts (server-side, cached per site). Default is the free public Open-Meteo API.
OPEN_METEO_URL=https://api.open-meteo.com/v1/forecast

# Airspace overlay on maps (optional). Free API key from https://www.openaip.net. Empty = no overlay.
NEXT_PUBLIC_OPENAIP_API_KEY=
