# Copy to deploy/.env on the server and fill in. Never commit it.
DOMAIN=app.flyanatolia.com
NEXT_PUBLIC_SITE_URL=https://app.flyanatolia.com

# Supabase project → Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
# Supabase project → Connect → Session pooler connection string (for backups)
SUPABASE_DB_URL=

NEXT_PUBLIC_AUTH_GOOGLE_ENABLED=false
LICENCE_ENCRYPTION_KEY=
INCIDENT_ENCRYPTION_KEY=
# Long random string; also needed to restore backups. Keep a copy outside the server.
BACKUP_PASSPHRASE=

# Brevo (free: 300 emails/day) → SMTP & API → SMTP
SMTP_HOST=smtp-relay.brevo.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM="ParaApp <no-reply@flyanatolia.com>"

NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:info@flyanatolia.com
CRON_SECRET=

OPEN_METEO_URL=https://api.open-meteo.com/v1/forecast
NEXT_PUBLIC_OPENAIP_API_KEY=
