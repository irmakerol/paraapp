{
  "name": "paraapp",
  "private": true,
  "packageManager": "pnpm@10.28.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "pnpm --filter @paraapp/web dev",
    "build": "pnpm -r build",
    "lint": "pnpm -r lint",
    "typecheck": "pnpm -r typecheck",
    "test": "pnpm -r test",
    "test:e2e": "pnpm --filter @paraapp/web test:e2e",
    "test:db": "bash scripts/db-test.sh",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "db:start": "supabase start",
    "db:stop": "supabase stop",
    "db:reset": "supabase db reset",
    "db:types": "supabase gen types typescript --local > apps/web/src/lib/supabase/database.types.ts"
  },
  "devDependencies": {
    "prettier": "^3.9.10",
    "supabase": "^2.122.0",
    "typescript": "6.0.3"
  }
}
